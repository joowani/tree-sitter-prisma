{
  "name": "tree-sitter-prisma",
  "version": "0.2.1",
  "description": "Prisma grammar for tree-sitter",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joowani/tree-sitter-prisma.git"
  },
  "license": "MIT",
  "author": {
    "name": "Joohwan Oh",
    "email": "joohwan.oh@outlook.com"
  },
  "main": "bindings/node/index.js",
  "types": "bindings/node/index.d.ts",
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "prisma"
  ],
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "*.wasm"
  ],
  "dependencies": {
    "node-addon-api": "^8.9.2",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "prebuildify": "^6.0.1",
    "tree-sitter": "^0.25.1",
    "tree-sitter-cli": "^0.27.1"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.1"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "install": "node-gyp-build",
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground",
    "generate": "tree-sitter generate",
    "parse": "tree-sitter parse",
    "test": "tree-sitter test",
    "test:node": "node --test bindings/node/*_test.js"
  },
  "allowScripts": {
    "tree-sitter-cli@0.27.1": true,
    "tree-sitter@0.25.1": true
  }
}
