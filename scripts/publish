#!/usr/bin/env bash

set -euo pipefail

cd "${BASH_SOURCE[0]%/*}/.."

# `--check` validates the version and stops, so the release workflow can reject bad input before requesting a token.
check_only=false
if [[ ${1:-} == --check ]]; then
    check_only=true
    shift
fi

version="${1:?usage: scripts/publish [--check] <version>}"
if [[ $# != 1 ]]; then
    echo "usage: scripts/publish [--check] <version>" >&2
    exit 1
fi

# Require a bare `x.y.z`, so neither a tag-shaped `v1.2.3` nor a pre-release suffix reaches `cargo publish`.
if [[ ! $version =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]]; then
    echo "version $version is not a bare x.y.z number" >&2
    exit 1
fi

# `tree-sitter version` updates neither lockfile, nor the parser that `tree-sitter generate` compiles the version into.
for manifest in Cargo.toml pyproject.toml package.json package-lock.json tree-sitter.json Makefile CMakeLists.txt \
    build.zig.zon Cargo.lock src/parser.c; do
    # These are awk field expressions, so the shell must leave dollar signs unchanged.
    # shellcheck disable=SC2016
    case "$manifest" in
        *.toml) pattern='/^version = "/ { print $2; exit }' ;;
        Cargo.lock) pattern='/^name = "tree-sitter-prisma"$/ { getline; print $2; exit }' ;;
        src/parser.c)
            pattern='/\.(major|minor|patch)_version = / { gsub(/[^0-9]/, ""); parts[++count] = $0 }
                count == 3 { print parts[1] "." parts[2] "." parts[3]; exit }'
            ;;
        *.json) pattern='/^[[:space:]]*"version": "/ { print $4; exit }' ;;
        Makefile) pattern='/^VERSION := / { split($0, parts, " "); print parts[3]; exit }' ;;
        CMakeLists.txt) pattern='/^[[:space:]]*VERSION "/ { print $2; exit }' ;;
        build.zig.zon) pattern='/^[[:space:]]*\.version = "/ { print $2; exit }' ;;
    esac
    manifest_version="$(awk -F '"' "$pattern" "$manifest")"
    if [[ $version != "$manifest_version" ]]; then
        echo "requested version $version does not match $manifest version $manifest_version" >&2
        exit 1
    fi
done

if [[ $check_only == true ]]; then
    exit 0
fi

user_agent="tree-sitter-prisma release workflow (https://github.com/joowani/tree-sitter-prisma)"

# Read the status code, since `curl --fail` cannot distinguish a network failure from a missing crate version.
status="$(curl --silent --show-error --output /dev/null --write-out '%{http_code}' \
    --user-agent "$user_agent" "https://crates.io/api/v1/crates/tree-sitter-prisma/$version")" || {
    echo "crates.io could not be reached while checking tree-sitter-prisma $version" >&2
    exit 1
}

case "$status" in
    200)
        echo "tree-sitter-prisma $version is already published; nothing to do"
        ;;
    404)
        cargo publish --locked
        ;;
    *)
        echo "crates.io answered $status while checking tree-sitter-prisma $version" >&2
        exit 1
        ;;
esac
